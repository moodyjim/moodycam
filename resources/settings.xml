        </setting>
        <setting id="list_cameras" type="action" label="32052">
          <level>0</level>
          <data>RunScript(special://home/addons/service.moodycam/test.py,cameras)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="debug" type="boolean" label="32053">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

  </section>
</settings>
