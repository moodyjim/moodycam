        </setting>
        <setting id="high_quality" type="boolean" label="32035">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="pause_playback" type="boolean" label="32036">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <category id="tools" label="32050">
