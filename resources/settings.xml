        </setting>
        <setting id="position" type="integer" label="32032">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="32040">0</option>
              <option label="32041">1</option>
              <option label="32042">2</option>
              <option label="32043">3</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="size" type="integer" label="32033">
          <level>0</level>
          <default>1</default>
          <constraints>
            <options>
              <option label="32044">0</option>
              <option label="32045">1</option>
              <option label="32046">2</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="refresh_ms" type="integer" label="32034">
          <level>0</level>
          <default>1000</default>
